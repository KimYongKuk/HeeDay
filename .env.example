# Copy to .env.local for local development. One file: local DB for the app, PROD_DATABASE_URL for prod migrations.

# --- Local (MariaDB 11.8 installed on the dev PC) ---
# Create once as root:
#   CREATE DATABASE heeday CHARACTER SET utf8mb4;
#   CREATE USER 'heeday'@'localhost' IDENTIFIED BY 'heeday';
#   GRANT ALL PRIVILEGES ON heeday.* TO 'heeday'@'localhost';
# (docker-compose.yml provides a MySQL 8 alternative for machines without MariaDB.)
DATABASE_URL=mysql://heeday:heeday@127.0.0.1:3306/heeday
DATABASE_SSL=0

# --- AI 도우미 (AWS Bedrock, Claude Sonnet 5.5) ---
# Leave the keys empty and the widget shows "설정되지 않았습니다". An IAM access key pair is enough.
# Names carry a HEEDAY_ prefix on purpose: Netlify functions run on AWS Lambda, which sets its own
# AWS_REGION / AWS_ACCESS_KEY_ID, so plain AWS_* names would be ignored or point at the wrong account.
# Enable the model in the Bedrock console (Model access) for this region first.
HEEDAY_AI_ENABLED=1
HEEDAY_AWS_REGION=us-east-1
HEEDAY_AI_MODEL=global.anthropic.claude-sonnet-5-5
# IAM access key (grant only Bedrock invoke permissions)
HEEDAY_AWS_ACCESS_KEY_ID=
HEEDAY_AWS_SECRET_ACCESS_KEY=
# HEEDAY_AWS_SESSION_TOKEN=
# Optional: a Bedrock API key instead of the IAM pair (takes precedence when set)
HEEDAY_BEDROCK_API_KEY=
# Optional: retry a refused answer on this model (must also be enabled in Bedrock)
# HEEDAY_AI_FALLBACK_MODEL=global.anthropic.claude-opus-4-8

# --- Production (MySQL-compatible managed DB, TLS required) ---
# Only `pnpm db:migrate --prod` reads this; dev, build and tests keep using DATABASE_URL above.
# PROD_DATABASE_URL=mysql://<user>.<prefix>:<password>@gateway01.<region>.prod.aws.tidbcloud.com:4000/heeday
#
# The host (Netlify) gets DATABASE_URL + DATABASE_SSL=1 with the same value in its own env settings.
# TiDB Serverless:
#   DATABASE_URL=mysql://<user>.<prefix>:<password>@gateway01.ap-northeast-1.prod.aws.tidbcloud.com:4000/heeday
#   DATABASE_SSL=1
# Aiven MySQL:
#   DATABASE_URL=mysql://avnadmin:<password>@<host>.aivencloud.com:<port>/heeday
#   DATABASE_SSL=1
